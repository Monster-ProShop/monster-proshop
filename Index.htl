<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Monster ProShop</title>
    
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="manifest" id="manifest">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dark: '#0f172a',
                        card: '#1e293b',
                        primary: '#10b981', // Monster Green
                        primaryHover: '#059669'
                    }
                }
            }
        }
    </script>
    <style>
        /* Hide scrollbars for cleaner mobile look */
        ::-webkit-scrollbar { display: none; }
        * { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-dark text-gray-200 font-sans antialiased pb-20">

    <header class="bg-card border-b border-gray-800 sticky top-0 z-40 px-4 py-4 shadow-lg flex justify-between items-center">
        <h1 class="text-xl font-black tracking-widest text-primary uppercase">Monster<span class="text-white">ProShop</span></h1>
        <button onclick="openForm()" class="bg-primary hover:bg-primaryHover text-white px-3 py-1.5 rounded text-sm font-bold shadow-md transition">
            + NEW
        </button>
    </header>

    <main class="p-4 w-full max-w-lg mx-auto" id="mainView">
        <div id="bowlerList" class="space-y-4">
            </div>
        <div id="emptyState" class="hidden flex flex-col items-center justify-center mt-20 text-center opacity-50">
            <svg class="w-16 h-16 mb-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <p>No bowlers found.<br>Tap + NEW to create a profile.</p>
        </div>
    </main>

    <div id="formModal" class="fixed inset-0 bg-dark z-50 hidden overflow-y-auto w-full max-w-lg mx-auto">
        <div class="sticky top-0 bg-card border-b border-gray-800 px-4 py-4 flex justify-between items-center z-10">
            <h2 id="formTitle" class="text-lg font-bold text-white">Bowler Profile</h2>
            <button onclick="closeForm()" class="text-gray-400 hover:text-white font-bold text-xl">&times;</button>
        </div>

        <form id="bowlerForm" onsubmit="saveBowler(event)" class="p-4 space-y-6">
            <input type="hidden" id="bowlerId">

            <div>
                <label class="block text-xs font-bold text-primary mb-1 uppercase">Bowler Name</label>
                <input type="text" id="bName" required class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="bg-card p-3 rounded-lg border border-gray-800">
                    <label class="block text-xs font-bold text-primary mb-2 uppercase">PAP</label>
                    <div class="flex gap-2">
                        <input type="text" id="papX" placeholder="X (e.g. 5 3/8)" class="w-1/2 bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                        <input type="text" id="papY" placeholder="Y (e.g. ^1)" class="w-1/2 bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                    </div>
                </div>
                <div class="bg-card p-3 rounded-lg border border-gray-800">
                    <label class="block text-xs font-bold text-primary mb-2 uppercase">Stats</label>
                    <div class="grid grid-cols-1 gap-2">
                        <input type="text" id="statRevs" placeholder="Revs (RPM)" class="w-full bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                        <input type="number" id="statAvg" placeholder="Average" class="w-full bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                        <input type="number" id="statSpeed" placeholder="Speed (MPH)" step="0.1" class="w-full bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                    </div>
                </div>
            </div>

            <div class="bg-card p-4 rounded-lg border border-gray-800 space-y-3">
                <label class="block text-xs font-bold text-primary uppercase">Drill Sheet</label>
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" id="spanLeft" placeholder="Left Span" class="bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                    <input type="text" id="spanRight" placeholder="Right Span" class="bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                    <input type="text" id="pitchFinger" placeholder="Finger Pitches" class="bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                    <input type="text" id="pitchThumb" placeholder="Thumb Pitches" class="bg-gray-900 border border-gray-700 rounded p-2 text-sm text-white">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mt-2 mb-1">Photo / Image</label>
                    <input type="file" accept="image/*" onchange="handleFile(event, 'drillPhoto')" class="text-sm text-gray-400 file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:bg-gray-800 file:text-white">
                    <input type="hidden" id="drillPhotoData">
                    <img id="drillPhotoPreview" class="hidden mt-2 max-h-40 rounded border border-gray-700 w-full object-contain bg-gray-900">
                </div>
            </div>

            <div class="bg-card p-4 rounded-lg border border-gray-800 space-y-2">
                <label class="block text-xs font-bold text-primary uppercase mb-2">Arsenal (9 Balls Max)</label>
                <div id="arsenalContainer" class="space-y-3">
                    </div>
            </div>

            <div class="bg-card p-4 rounded-lg border border-gray-800">
                <label class="block text-xs font-bold text-primary uppercase mb-1">Release Video</label>
                <input type="file" accept="video/*" onchange="handleFile(event, 'video')" class="text-sm text-gray-400 file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:bg-gray-800 file:text-white w-full">
                <input type="hidden" id="videoData">
                <video id="videoPreview" controls class="hidden mt-3 w-full rounded border border-gray-700 bg-black max-h-48"></video>
            </div>

            <div class="pt-4 flex gap-3 pb-8">
                <button type="submit" class="flex-1 bg-primary text-white font-bold py-3 rounded-lg shadow">SAVE PROFILE</button>
                <button type="button" id="deleteBtn" onclick="deleteProfile()" class="hidden bg-red-900/50 text-red-400 font-bold px-4 py-3 rounded-lg border border-red-900">DELETE</button>
            </div>
        </form>
    </div>

    <script>
        // --- 1. PWA Setup (Manifest & Inline Service Worker) ---
        const manifest = {
            name: "Monster ProShop",
            short_name: "ProShop",
            display: "standalone",
            background_color: "#0f172a",
            theme_color: "#0f172a",
            start_url: location.href,
            icons: [{"src": "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎳</text></svg>", "sizes": "192x192", "type": "image/svg+xml"}]
        };
        document.getElementById('manifest').href = 'data:application/manifest+json;charset=utf-8,' + encodeURIComponent(JSON.stringify(manifest));

        if ('serviceWorker' in navigator) {
            const sw = `self.addEventListener('fetch', () => {}); self.addEventListener('install', e => self.skipWaiting());`;
            const blob = new Blob([sw], { type: 'text/javascript' });
            navigator.serviceWorker.register(URL.createObjectURL(blob));
        }

        // --- 2. Arsenal Setup ---
        const finishes = ['500','500P','1000','1000P','1500','1500P','2000','2000P','3000','3000P','4000','4000P'];
        const arsenalDiv = document.getElementById('arsenalContainer');
        for(let i=0; i<9; i++) {
            arsenalDiv.innerHTML += `
                <div class="flex gap-2 items-center bg-gray-900 p-2 rounded border border-gray-800">
                    <span class="text-xs text-gray-500 font-bold w-4">${i+1}</span>
                    <input type="text" id="ball_name_${i}" placeholder="Brand / Name" class="flex-1 bg-transparent border-b border-gray-700 text-sm text-white focus:border-primary outline-none py-1">
                    <input type="text" id="ball_layout_${i}" placeholder="Layout" class="w-1/4 bg-transparent border-b border-gray-700 text-sm text-white focus:border-primary outline-none py-1">
                    <select id="ball_finish_${i}" class="bg-gray-800 border border-gray-700 rounded text-xs text-white p-1">
                        <option value="">Finish</option>
                        ${finishes.map(f => `<option value="${f}">${f}</option>`).join('')}
                    </select>
                </div>
            `;
        }

        // --- 3. IndexedDB Setup (For large file storage) ---
        let db;
        const request = indexedDB.open("MonsterProShopDB", 1);
        
        request.onupgradeneeded = (e) => {
            db = e.target.result;
            if (!db.objectStoreNames.contains("bowlers")) {
                db.createObjectStore("bowlers", { keyPath: "id" });
            }
        };
        
        request.onsuccess = (e) => {
            db = e.target.result;
            loadList();
        };

        // --- 4. Logic & UI ---
        function loadList() {
            const tx = db.transaction("bowlers", "readonly");
            const store = tx.objectStore("bowlers");
            const req = store.getAll();
            
            req.onsuccess = () => {
                const bowlers = req.result;
                const list = document.getElementById('bowlerList');
                const empty = document.getElementById('emptyState');
                
                if(bowlers.length === 0) {
                    list.innerHTML = '';
                    empty.classList.remove('hidden');
                } else {
                    empty.classList.add('hidden');
                    list.innerHTML = bowlers.map(b => `
                        <div onclick="openForm('${b.id}')" class="bg-card p-4 rounded-xl border border-gray-700 shadow flex justify-between items-center cursor-pointer active:scale-95 transition-transform">
                            <div>
                                <h3 class="font-bold text-white text-lg">${b.name}</h3>
                                <div class="text-xs text-gray-400 mt-1 flex gap-3">
                                    <span>Avg: <strong class="text-gray-200">${b.avg || '-'}</strong></span>
                                    <span>Rev: <strong class="text-gray-200">${b.revs || '-'}</strong></span>
                                    <span>Spd: <strong class="text-gray-200">${b.speed ? b.speed+'mph' : '-'}</strong></span>
                                </div>
                            </div>
                            <div class="text-primary font-bold">›</div>
                        </div>
                    `).join('');
                }
            };
        }

        function handleFile(e, targetId) {
            const file = e.target.files[0];
            if(!file) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                const b64 = event.target.result;
                if(targetId === 'drillPhoto') {
                    document.getElementById('drillPhotoData').value = b64;
                    const img = document.getElementById('drillPhotoPreview');
                    img.src = b64;
                    img.classList.remove('hidden');
                } else if(targetId === 'video') {
                    document.getElementById('videoData').value = b64;
                    const vid = document.getElementById('videoPreview');
                    vid.src = b64;
                    vid.classList.remove('hidden');
                }
            };
            reader.readAsDataURL(file);
        }

        function openForm(id = null) {
            document.getElementById('bowlerForm').reset();
            document.getElementById('drillPhotoPreview').classList.add('hidden');
            document.getElementById('videoPreview').classList.add('hidden');
            document.getElementById('drillPhotoData').value = '';
            document.getElementById('videoData').value = '';
            
            if (id) {
                document.getElementById('formTitle').innerText = "Edit Profile";
                document.getElementById('deleteBtn').classList.remove('hidden');
                
                const tx = db.transaction("bowlers", "readonly");
                const req = tx.objectStore("bowlers").get(id);
                req.onsuccess = () => {
                    const b = req.result;
                    document.getElementById('bowlerId').value = b.id;
                    document.getElementById('bName').value = b.name;
                    document.getElementById('papX').value = b.papX;
                    document.getElementById('papY').value = b.papY;
                    document.getElementById('statRevs').value = b.revs;
                    document.getElementById('statAvg').value = b.avg;
                    document.getElementById('statSpeed').value = b.speed;
                    document.getElementById('spanLeft').value = b.spanLeft;
                    document.getElementById('spanRight').value = b.spanRight;
                    document.getElementById('pitchFinger').value = b.pitchFinger;
                    document.getElementById('pitchThumb').value = b.pitchThumb;
                    
                    if(b.photo) {
                        document.getElementById('drillPhotoData').value = b.photo;
                        document.getElementById('drillPhotoPreview').src = b.photo;
                        document.getElementById('drillPhotoPreview').classList.remove('hidden');
                    }
                    if(b.video) {
                        document.getElementById('videoData').value = b.video;
                        document.getElementById('videoPreview').src = b.video;
                        document.getElementById('videoPreview').classList.remove('hidden');
                    }

                    b.arsenal.forEach((ball, i) => {
                        document.getElementById(`ball_name_${i}`).value = ball.name;
                        document.getElementById(`ball_layout_${i}`).value = ball.layout;
                        document.getElementById(`ball_finish_${i}`).value = ball.finish;
                    });
                };
            } else {
                document.getElementById('formTitle').innerText = "New Bowler";
                document.getElementById('bowlerId').value = Date.now().toString();
                document.getElementById('deleteBtn').classList.add('hidden');
            }
            
            document.getElementById('formModal').classList.remove('hidden');
        }

        function closeForm() {
            document.getElementById('formModal').classList.add('hidden');
            // Stop video playing if closed
            document.getElementById('videoPreview').pause(); 
        }

        function saveBowler(e) {
            e.preventDefault();
            const id = document.getElementById('bowlerId').value;
            
            let arsenal = [];
            for(let i=0; i<9; i++) {
                arsenal.push({
                    name: document.getElementById(`ball_name_${i}`).value,
                    layout: document.getElementById(`ball_layout_${i}`).value,
                    finish: document.getElementById(`ball_finish_${i}`).value
                });
            }

            const bowler = {
                id: id,
                name: document.getElementById('bName').value,
                papX: document.getElementById('papX').value,
                papY: document.getElementById('papY').value,
                revs: document.getElementById('statRevs').value,
                avg: document.getElementById('statAvg').value,
                speed: document.getElementById('statSpeed').value,
                spanLeft: document.getElementById('spanLeft').value,
                spanRight: document.getElementById('spanRight').value,
                pitchFinger: document.getElementById('pitchFinger').value,
                pitchThumb: document.getElementById('pitchThumb').value,
                photo: document.getElementById('drillPhotoData').value,
                video: document.getElementById('videoData').value,
                arsenal: arsenal
            };

            const tx = db.transaction("bowlers", "readwrite");
            tx.objectStore("bowlers").put(bowler);
            tx.oncomplete = () => {
                closeForm();
                loadList();
            };
        }

        function deleteProfile() {
            const id = document.getElementById('bowlerId').value;
            if(confirm("Delete this bowler profile? This cannot be undone.")) {
                const tx = db.transaction("bowlers", "readwrite");
                tx.objectStore("bowlers").delete(id);
                tx.oncomplete = () => {
                    closeForm();
                    loadList();
                };
            }
        }
    </script>
</body>
</html>
